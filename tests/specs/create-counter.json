[
  {
    "name": "Create counter opens type choices",
    "steps": [
      {
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "Choose the counter type."
            }
          }
        ],
        "send": {
          "callback": "create:counter"
        }
      }
    ]
  },
  {
    "name": "personal creation asks for a name and handles an unconfigured store",
    "steps": [
      { "send": { "callback": "create:counter" }, "expect": [{ "method": "editMessageText", "payload": { "text": "Choose the counter type." } }] },
      { "send": { "callback": "create:type:personal" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Send a name for your personal counter." } }] },
      { "send": { "text": "Water" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Counter storage isn't set up yet." } }] }
    ]
  },
  {
    "name": "non-admin cannot start a shared counter",
    "steps": [
      { "send": { "callback": "create:type:shared" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Only a shared-counter admin can create that." } }] }
    ]
  }
]
